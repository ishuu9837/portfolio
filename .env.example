# Required only to serve the existing /manus-storage/* image assets on Vercel.
# Set these in Vercel Project Settings → Environment Variables; never expose the key with a VITE_ prefix.
BUILT_IN_FORGE_API_URL=https://forge.example.com
BUILT_IN_FORGE_API_KEY=replace-with-server-side-key

# Optional Umami analytics. Leave both unset to disable analytics.
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=replace-with-website-id
